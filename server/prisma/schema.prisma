// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Development Requester ────────────────────────────────────────────────────

model RequesterUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets             Ticket[]     @relation("TicketRequester")
  ownedTickets        Ticket[]     @relation("TicketOwner")
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  removedAttachments  Attachment[] @relation("AttachmentRemover")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ─── Related System ───────────────────────────────────────────────────────────

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model Ticket {
  id           Int    @id @default(autoincrement())
  ticketNumber String @unique

  requesterId Int
  requester   RequesterUser @relation("TicketRequester", fields: [requesterId], references: [id])

  categoryId      Int
  category        Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  summary     String
  description String

  requestedPriority Priority     @default(MEDIUM)
  itPriority        Priority     @default(MEDIUM)
  currentStatus     TicketStatus @default(NEW)

  ticketOwnerId Int?
  ticketOwner   RequesterUser? @relation("TicketOwner", fields: [ticketOwnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([requesterId])
  @@index([currentStatus, categoryId, requestedPriority])
  @@index([createdAt])
  @@index([updatedAt])
}

// ─── Attachment ───────────────────────────────────────────────────────────────

model Attachment {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  uploaderId Int
  uploader   RequesterUser @relation("AttachmentUploader", fields: [uploaderId], references: [id])

  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  storagePath      String

  removedAt            DateTime?
  removedByRequesterId Int?
  removedBy            RequesterUser? @relation("AttachmentRemover", fields: [removedByRequesterId], references: [id])
  removalReason        String?

  createdAt DateTime @default(now())

  @@index([ticketId])
}
